<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechnoMarkt</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }
    </style>
</head>
<body class="bg-[#0D1120] min-h-screen flex flex-col">

    @await Html.PartialAsync("~/Views/Shared/Partials/Common/_Toast.cshtml")

    <header class="w-full h-16 bg-[#1A2744] flex items-center px-8 gap-3">
        <i class="fa-solid fa-bolt text-[#FFAB00] text-xl"></i>
        <span class="text-xl font-bold text-white tracking-tight">TechnoMarkt</span>
    </header>

    <main class="flex-1 flex items-center justify-center px-4 py-12">
        @RenderBody()
    </main>

    <footer class="py-4 text-center text-[11px] text-gray-600">
        © @DateTime.Now.Year TechnoMarkt. Всі права захищені.
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>

