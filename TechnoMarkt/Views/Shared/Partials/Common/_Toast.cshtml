@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
    var warning = TempData["Warning"] as string;
    var info = TempData["Info"] as string;
}

@if (success != null || error != null || warning != null || info != null)
{
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none" style="max-width: 380px;">

        @if (success != null)
        {
            <div class="toast-item pointer-events-auto flex items-start gap-3 px-4 py-3.5 rounded-xl 
                        bg-green-950/90 border border-green-500/30 backdrop-blur-sm shadow-xl animate-slide-in">
                <i class="fa-solid fa-circle-check text-green-400 mt-0.5 flex-shrink-0"></i>
                <p class="text-sm text-green-100 flex-1">@success</p>
                <button onclick="dismissToast(this)" class="text-green-500 hover:text-green-300 transition-colors flex-shrink-0">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>
            </div>
        }

        @if (error != null)
        {
            <div class="toast-item pointer-events-auto flex items-start gap-3 px-4 py-3.5 rounded-xl
                         bg-red-950/90 border border-red-500/30 backdrop-blur-sm shadow-xl animate-slide-in">
                <i class="fa-solid fa-circle-xmark text-red-400 mt-0.5 flex-shrink-0"></i>
                <p class="text-sm text-red-100 flex-1">@error</p>
                <button onclick="dismissToast(this)" class="text-red-500 hover:text-red-300 transition-colors flex-shrink-0">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>
            </div>
        }

        @if (warning != null)
        {
            <div class="toast-item pointer-events-auto flex items-start gap-3 px-4 py-3.5 rounded-xl
                         bg-amber-950/90 border border-amber-500/30 backdrop-blur-sm shadow-xl animate-slide-in">
                <i class="fa-solid fa-triangle-exclamation text-amber-400 mt-0.5 flex-shrink-0"></i>
                <p class="text-sm text-amber-100 flex-1">@warning</p>
                <button onclick="dismissToast(this)" class="text-amber-500 hover:text-amber-300 transition-colors flex-shrink-0">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>
            </div>
        }

        @if (info != null)
        {
            <div class="toast-item pointer-events-auto flex items-start gap-3 px-4 py-3.5 rounded-xl
                         bg-blue-950/90 border border-blue-500/30 backdrop-blur-sm shadow-xl animate-slide-in">
                <i class="fa-solid fa-circle-info text-blue-400 mt-0.5 flex-shrink-0"></i>
                <p class="text-sm text-blue-100 flex-1">@info</p>
                <button onclick="dismissToast(this)" class="text-blue-500 hover:text-blue-300 transition-colors flex-shrink-0">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>
            </div>
        }
    </div>

<style>
       @@keyframes slideIn {
            from { opacity: 0; transform: translateX(1rem); }
            to   { opacity: 1; transform: translateX(0); }
        }
        .animate-slide-in { animation: slideIn 0.25s ease-out; }
</style>

<script>
    function dismissToast(btn) {
        const toast = btn.closest('.toast-item');
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(1rem)';
        toast.style.transition = 'all 0.2s ease-in';
        setTimeout(() => toast.remove(), 200);
    }

    
    setTimeout(() => {
        document.querySelectorAll('.toast-item').forEach(t => dismissToast(t.querySelector('button')));
    }, 5000);
    </script>
}