@model SignUpVM

@{
    Layout = "~/Views/Shared/Partials/Layout/_AccountLayout.cshtml";
    ViewData["Title"] = "Реєстрація";
}

<div class="w-full max-w-md">

    <div class="text-center mb-8">
        <div class="w-14 h-14 bg-[#1A2744] rounded-2xl flex items-center justify-center mx-auto mb-4 border border-gray-700">
            <i class="fa-solid fa-bolt text-[#FFAB00] text-2xl"></i>
        </div>
        <h1 class="text-2xl font-bold text-white tracking-tight">Створити акаунт</h1>
        <p class="text-sm text-gray-400 mt-1">Заповніть форму для реєстрації</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mb-5 p-4 rounded-xl bg-red-500/10 border border-red-500/20 flex items-start gap-3">
            <i class="fa-solid fa-circle-exclamation text-red-400 mt-0.5 flex-shrink-0"></i>
            <div class="space-y-1">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p class="text-sm text-red-400">@error.ErrorMessage</p>
                }
            </div>
        </div>
    }

    <div class="bg-[#1A2744] rounded-2xl border border-gray-700/50 p-8">
        <form asp-action="SignUp" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()

            <div class="space-y-5">

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-2">Ім?я</label>
                        <input asp-for="FirstName" placeholder="Іван" class="w-full px-4 py-3 rounded-xl 
                                      bg-[#0D1120] border border-gray-700 text-white text-sm placeholder-gray-600
                                      focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors" />
                        <span asp-validation-for="FirstName" class="text-[11px] text-red-400 mt-1 block"></span>
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-2">Прізвище</label>
                        <input asp-for="LastName" placeholder="Іваненко" class="w-full px-4 py-3 rounded-xl 
                                      bg-[#0D1120] border border-gray-700 text-white text-sm placeholder-gray-600
                                      focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors" />
                        <span asp-validation-for="LastName" class="text-[11px] text-red-400 mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-2">Email</label>
                    <div class="relative">
                        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none">
                            <i class="fa-solid fa-envelope text-sm"></i>
                        </span>
                        <input asp-for="Email" type="email" placeholder="your@email.com" class="w-full pl-10 pr-4 py-3 rounded-xl 
                                      bg-[#0D1120] border border-gray-700 text-white text-sm placeholder-gray-600
                                      focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors" />
                    </div>
                    <span asp-validation-for="Email" class="text-[11px] text-red-400 mt-1 block"></span>
                </div>

                <div>
                    <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-2">Пароль</label>
                    <div class="relative">
                        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none">
                            <i class="fa-solid fa-lock text-sm"></i>
                        </span>
                        <input asp-for="Password" type="password" id="password-input" placeholder="Мінімум 6 символів"
                               class="w-full pl-10 pr-11 py-3 rounded-xl bg-[#0D1120] border border-gray-700 text-white text-sm placeholder-gray-600
                                      focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors" />
                        <button type="button" onclick="togglePassword('password-input', 'eye-1')"
                                class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-300 transition-colors">
                            <i id="eye-1" class="fa-solid fa-eye text-sm"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-[11px] text-red-400 mt-1 block"></span>
                </div>

                <div>
                    <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-2">Підтвердження паролю</label>
                    <div class="relative">
                        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none">
                            <i class="fa-solid fa-lock text-sm"></i>
                        </span>
                        <input asp-for="ConfirmPassword" type="password" id="confirm-input" placeholder="Повторіть пароль"
                               class="w-full pl-10 pr-11 py-3 rounded-xl bg-[#0D1120] border border-gray-700 text-white text-sm placeholder-gray-600
                                      focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors" />
                        <button type="button" onclick="togglePassword('confirm-input', 'eye-2')"
                                class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-300 transition-colors">
                            <i id="eye-2" class="fa-solid fa-eye text-sm"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-[11px] text-red-400 mt-1 block"></span>
                </div>

                <button type="submit" class="w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold
                        transition-colors flex items-center justify-center gap-2">
                    <i class="fa-solid fa-user-plus"></i>
                    Зареєструватись
                </button>
            </div>
        </form>

        <div class="mt-6 pt-6 border-t border-gray-700/50 text-center">
            <p class="text-sm text-gray-500">
                Вже є акаунт?
                <a asp-action="Login" asp-controller="Account" class="text-blue-400 hover:text-blue-300 font-medium transition-colors">Увійти</a>
            </p>
        </div>
    </div>
</div>


<script>
    function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon  = document.getElementById(iconId);
        const isHidden = input.type === 'password';
        input.type = isHidden ? 'text' : 'password';
        icon.className = isHidden ? 'fa-solid fa-eye-slash text-sm' : 'fa-solid fa-eye text-sm';
    }
</script>
