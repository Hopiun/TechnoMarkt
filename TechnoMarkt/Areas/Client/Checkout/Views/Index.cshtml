@model CheckoutVM
@{
    Layout = null;
    var cart = ViewData["Cart"] as CartVM;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Оформлення замовлення - TechnoMarkt</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #f3f4f6;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center py-10 px-4">

    <div class="max-w-2xl w-full bg-white rounded-3xl shadow-xl overflow-hidden">

        <div class="bg-[#003DA5] px-8 py-6 flex items-center justify-between">
            <h2 class="text-2xl font-bold text-white flex items-center gap-3">
                <i class="fa-solid fa-bag-shopping text-[#FFE000]"></i> Оформлення замовлення
            </h2>
            <a href="/Home/Home/Index" class="text-blue-200 hover:text-white transition-colors" title="Повернутися на головну">
                <i class="fa-solid fa-xmark text-2xl"></i>
            </a>
        </div>

        <div class="p-8">
            @if (TempData["Error"] != null)
            {
                <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl mb-6 relative shadow-sm text-sm" role="alert">
                    <i class="fa-solid fa-circle-xmark mr-2"></i>@TempData["Error"]
                </div>
            }

            @if (cart != null && cart.Items.Any())
            {
                <div class="mb-8">
                    <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Склад замовлення</h3>
                    <div class="space-y-3 bg-gray-50 rounded-2xl p-5 border border-gray-100">
                        @foreach (var item in cart.Items)
                        {
                            <div class="flex justify-between items-center gap-4">
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-bold text-gray-900 truncate">@item.Name</p>
                                    <div class="flex items-center gap-2 mt-0.5">
                                        <span class="text-[11px] font-semibold text-gray-500 bg-gray-200 px-1.5 py-0.5 rounded">@(item.Quantity) шт.</span>
                                        @if (item.DiscountPercent > 0)
                                        {
                                            <span class="text-[11px] text-gray-400 line-through">₴@item.OriginalPrice.ToString("N0")</span>
                                            <span class="text-[11px] font-semibold text-red-500 bg-red-100 px-1.5 py-0.5 rounded">-@item.DiscountPercent%</span>
                                            <span class="text-[11px] text-gray-700">&times; ₴@item.DiscountedPrice.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span class="text-[11px] text-gray-500">&times; ₴@item.OriginalPrice.ToString("N0")</span>
                                        }
                                    </div>
                                </div>
                                <strong class="text-sm text-gray-900 shrink-0">₴@item.LineTotal.ToString("N0")</strong>
                            </div>
                        }

                        <div class="border-t border-gray-200 pt-4 mt-4 space-y-2">
                            <div class="flex justify-between items-center">
                                <span class="text-sm font-medium text-gray-500">Сума без знижок:</span>
                                <span class="text-sm font-semibold text-gray-700">₴@cart.TotalOriginalAmount.ToString("N0")</span>
                            </div>
                            @if (cart.TotalDiscount > 0)
                            {
                                <div class="flex justify-between items-center text-green-600">
                                    <span class="text-sm font-medium">Знижка:</span>
                                    <span class="text-sm font-semibold">-₴@cart.TotalDiscount.ToString("N0")</span>
                                </div>
                            }
                            <div class="flex justify-between items-center pt-2 border-t border-gray-200">
                                <span class="text-sm font-medium text-gray-500">До сплати:</span>
                                <span class="text-2xl font-black text-[#003DA5]">₴@cart.TotalAmount.ToString("N0")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <form asp-action="Process" asp-area="Client" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm font-medium mb-4 p-3 bg-red-50 rounded-lg"></div>

                    <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Зручний спосіб оплати</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                        <label class="flex flex-col p-4 border-2 border-transparent bg-gray-50 rounded-2xl cursor-pointer hover:bg-gray-100 transition-colors has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 relative">
                            <div class="flex items-center gap-3 mb-2">
                                <input class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-blue-500" type="radio" asp-for="PaymentMethod" value="@PayMethod.Online" checked />
                                <span class="font-bold text-gray-900 text-sm">З бонусного рахунку</span>
                            </div>
                            <span class="text-[11px] text-gray-500 pl-7 leading-relaxed">Миттєва оплата доступними бонусами. Баланс оновиться автоматично.</span>
                        </label>

                        <label class="flex flex-col p-4 border-2 border-transparent bg-gray-50 rounded-2xl cursor-pointer hover:bg-gray-100 transition-colors has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 relative">
                            <div class="flex items-center gap-3 mb-2">
                                <input class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-blue-500" type="radio" asp-for="PaymentMethod" value="@PayMethod.Card" />
                                <span class="font-bold text-gray-900 text-sm">У відділенні</span>
                            </div>
                            <span class="text-[11px] text-gray-500 pl-7 leading-relaxed">Оплата карткою або готівкою при отриманні замовлення.</span>
                        </label>
                    </div>

                    <div class="mb-8">
                        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Додатково</h3>
                        <textarea asp-for="Comment" class="w-full border-0 bg-gray-50 rounded-2xl px-4 py-3 text-sm text-gray-900 focus:ring-2 focus:ring-blue-500 transition-shadow resize-none" rows="2" placeholder="Залиште коментар (за потреби)..."></textarea>
                    </div>

                    <div class="flex items-center gap-4 pt-2">
                        <a href="#" onclick="history.back(); return false;" class="px-6 py-3.5 text-sm font-bold text-gray-500 hover:text-gray-900 transition-colors">
                            Скасувати
                        </a>
                        <button type="submit" class="flex-1 bg-[#FFE000] hover:brightness-105 text-black font-bold py-3.5 px-6 rounded-xl transition-all shadow-md flex items-center justify-center gap-2">
                            Підтвердити замовлення <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</body>
</html>




