@model WalletViewModel

@{
    ViewData["Title"] = "Гаманець та способи оплати";
    Layout = "_ClientCabinetLayout";
}

<div class="max-w-5xl mx-auto space-y-8 animate-slide-in">
    
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-black text-gray-900 tracking-tight">Способи оплати</h1>
            <p class="text-sm text-gray-500 mt-1">Керуйте своїми картками та бонусним рахунком</p>
        </div>
        <button onclick="document.getElementById('add-card-modal').classList.remove('hidden')" class="px-5 py-2.5 bg-[#FFE000] text-black font-bold rounded-xl shadow-md hover:brightness-110 active:scale-95 transition-all flex items-center gap-2">
            <i class="fa-solid fa-plus text-sm"></i>
            Додати картку
        </button>
    </div>

    
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-100 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center">
                <i class="fa-regular fa-credit-card"></i>
            </div>
            <div>
                <h2 class="font-bold text-gray-900">Збережені картки</h2>
                <p class="text-xs text-gray-500">Ваші способи оплати для швидкого оформлення</p>
            </div>
        </div>
        <div class="px-6 py-8 bg-gray-50/50">
            @if (!Model.PaymentMethods.Any())
            {
                <div class="text-center py-8">
                    <i class="fa-regular fa-credit-card text-4xl text-gray-300 mb-3"></i>
                    <p class="text-gray-500 font-medium">У вас ще немає збережених карток</p>
                    <button onclick="document.getElementById('add-card-modal').classList.remove('hidden')" class="mt-4 text-blue-600 font-bold text-sm hover:underline">
                        Додати першу картку
                    </button>
                </div>
            }
            else
            {
                <div class="flex overflow-x-auto pb-4 gap-6 snap-x">
                    @foreach (var method in Model.PaymentMethods)
                    {
                        var isVisa = method.CardType.ToLower() == "visa";
                        var isMaster = method.CardType.ToLower() == "mastercard";
                        var bgClass = isVisa ? "from-blue-900 to-[#003DA5]" : (isMaster ? "from-[#1a1f36] to-[#3a4256]" : "from-gray-800 to-gray-600");
                        var iconClass = isVisa ? "fa-cc-visa" : (isMaster ? "fa-cc-mastercard" : "fa-credit-card");
                        var maskedCard = "**** **** **** " + method.CardNumber.Substring(method.CardNumber.Length - 4);

                        <div class="snap-start flex-shrink-0 w-80 h-48 rounded-2xl bg-gradient-to-br @bgClass text-white p-6 shadow-xl relative overflow-hidden group">
                            <div class="absolute top-0 right-0 w-32 h-32 bg-white opacity-5 rounded-full -mr-10 -mt-10 pointer-events-none"></div>
                            
                            
                            <form asp-action="DeletePaymentMethod" method="post" class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity" onsubmit="return confirm('Ви впевнені, що хочете видалити цю картку?');">
                                <input type="hidden" name="paymentMethodId" value="@method.PaymentMethodId" />
                                <button type="submit" class="w-8 h-8 rounded-full bg-white/20 hover:bg-red-500/80 text-white flex items-center justify-center transition-colors shadow-sm" title="Видалити картку">
                                    <i class="fa-solid fa-trash-can text-sm"></i>
                                </button>
                            </form>

                            <div class="flex flex-col h-full justify-between">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="text-xs text-blue-200 uppercase tracking-wider font-semibold">@method.BankName</p>
                                    </div>
                                    <i class="fa-brands @iconClass text-4xl text-white/90"></i>
                                </div>
                                
                                <div class="font-mono text-xl tracking-widest text-blue-50 mt-4 shadow-sm">
                                    @maskedCard
                                </div>
                                <div class="mt-2 text-[10px] text-blue-200 uppercase tracking-widest">Technomarkt Client</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden flex flex-col md:flex-row">
        <div class="md:w-1/3 bg-blue-600 p-8 text-white flex flex-col justify-center items-center relative overflow-hidden">
            <i class="fa-solid fa-wallet text-6xl opacity-10 absolute -bottom-4 -left-4"></i>
            <h3 class="text-blue-200 font-bold text-sm uppercase tracking-wider mb-2">Бонусний рахунок</h3>
            <div class="text-4xl font-black tracking-tight">₴@Model.Balance.ToString("N0")</div>
        </div>
        <div class="md:w-2/3 p-8">
            <h3 class="text-lg font-bold text-gray-900 mb-2">Поповнити гаманець</h3>
            <p class="text-sm text-gray-500 mb-6">Кошти з гаманця можна використовувати для оплати товарів під час оформлення замовлення.</p>
            
            <form asp-action="TopUp" method="post" class="flex items-end gap-4 max-w-sm">
                <div class="flex-1">
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Сума (₴)</label>
                    <input type="number" name="amount" min="1" max="50000" step="1" required placeholder="Напр. 1000"
                           class="w-full h-11 px-4 bg-gray-50 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition-colors" />
                </div>
                <button type="submit" class="h-11 px-6 bg-gray-900 hover:bg-gray-800 text-white font-semibold rounded-xl transition-colors shadow-sm whitespace-nowrap">
                    Поповнити
                </button>
            </form>
        </div>
    </div>

</div>


<div id="add-card-modal" class="hidden fixed inset-0 z-[100] bg-gray-900/50 backdrop-blur-sm flex items-center justify-center opacity-100 transition-opacity">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden transform scale-100 transition-transform">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
            <h2 class="font-bold text-lg text-gray-900">Додавання картки</h2>
            <button type="button" onclick="document.getElementById('add-card-modal').classList.add('hidden')" class="w-8 h-8 rounded-full hover:bg-gray-200 text-gray-500 flex items-center justify-center transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="p-6">
            <form asp-action="AddPaymentMethod" method="post" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Назва банку</label>
                    <input type="text" name="BankName" required placeholder="Monobank, ПриватБанк..."
                           class="w-full h-11 px-4 bg-gray-50 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition-colors" />
                </div>
                
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Номер картки</label>
                    <input type="text" name="CardNumber" required maxlength="16" minlength="16" pattern="\d{16}" placeholder="1111222233334444"
                           class="w-full h-11 px-4 font-mono bg-gray-50 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition-colors" 
                           title="Номер має містити 16 цифр без пробілів" />
                </div>
                
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Тип платіжної системи</label>
                    <select name="CardType" required class="w-full h-11 px-4 bg-gray-50 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition-colors appearance-none">
                        <option value="Visa">Visa</option>
                        <option value="MasterCard">MasterCard</option>
                    </select>
                </div>

                <div class="pt-4 flex gap-3">
                    <button type="button" onclick="document.getElementById('add-card-modal').classList.add('hidden')" class="flex-1 px-4 py-2.5 rounded-xl border border-gray-300 text-gray-700 font-semibold hover:bg-gray-50 transition-colors">
                        Скасувати
                    </button>
                    <button type="submit" class="flex-1 px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-sm transition-colors">
                        Зберегти картку
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

