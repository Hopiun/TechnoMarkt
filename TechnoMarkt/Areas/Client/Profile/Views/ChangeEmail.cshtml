@model ChangeEmailFormVM
@{
    ViewData["Title"] = "Зміна Email";
    Layout = "_ClientCabinetLayout";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-8">
        <a href="@Url.Action("Index", "Profile")" 
           class="inline-flex items-center gap-2 text-[#003DA5] hover:text-[#002A7A] font-semibold text-sm mb-4 no-underline">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Назад до профілю</span>
        </a>
        <h1 class="text-3xl font-bold text-gray-900">Зміна Email</h1>
        <p class="text-gray-600 mt-1">Введіть новий email та підтвердіть паролем</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6">
        <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-4"></div>
        
        <form method="post" action="@Url.Action("ChangeEmail", "Profile")">
            @Html.AntiForgeryToken()
            
            <div class="space-y-6">
                <div>
                    <label asp-for="NewEmail" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                    <input asp-for="NewEmail" 
                           type="email" 
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#003DA5] focus:border-[#003DA5] transition-colors"
                           placeholder="newemail@example.com" />
                    <span asp-validation-for="NewEmail" class="text-red-600 text-sm mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="CurrentPassword" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                    <input asp-for="CurrentPassword" 
                           type="password" 
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#003DA5] focus:border-[#003DA5] transition-colors"
                           placeholder="Введіть поточний пароль" />
                    <span asp-validation-for="CurrentPassword" class="text-red-600 text-sm mt-1 block"></span>
                </div>

                <div class="flex gap-3 pt-4">
                    <a href="@Url.Action("Index", "Profile")" 
                       class="flex-1 px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-lg transition-colors text-center no-underline">
                        Скасувати
                    </a>
                    <button type="submit" 
                            class="flex-1 px-4 py-2.5 bg-[#003DA5] hover:bg-[#002A7A] text-white font-semibold rounded-lg transition-colors">
                        <i class="fa-solid fa-check mr-2"></i>Змінити Email
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@{ await Html.RenderPartialAsync("~/Views/Shared/Partials/Common/_ValidationScriptsPartial.cshtml"); }

