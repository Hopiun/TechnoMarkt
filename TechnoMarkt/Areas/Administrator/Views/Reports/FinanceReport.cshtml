@model FinanceViewModel
@{
    Layout = null;
    string generatedAt = DateTime.Now.ToString("dd.MM.yyyy HH:mm");
    string periodLabel = (Model.DateFilter?.DateFrom.HasValue == true && Model.DateFilter?.DateTo.HasValue == true)
        ? $"{Model.DateFilter.DateFrom.Value:dd.MM.yyyy} – {Model.DateFilter.DateTo.Value:dd.MM.yyyy}"
        : $"Поточний місяць ({DateTime.Now:MMMM yyyy})";
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <title>Фінансовий звіт — TechnoMarkt</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Times New Roman', Times, serif; 
            font-size: 13px;
            color: #000;
            background: #fff;
            padding: 40px;
        }

        
        .report-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 2px solid #000;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .logo-block { display: flex; align-items: center; gap: 15px; }
        .logo-icon {
            width: 48px; height: 48px;
            border: 2px solid #000;
            display: flex; align-items: center; justify-content: center;
            font-size: 24px; font-weight: bold; font-family: sans-serif;
        }
        .logo-text { font-size: 24px; font-weight: bold; text-transform: uppercase; font-family: sans-serif; letter-spacing: 1px; }
        .logo-sub { font-size: 12px; font-family: sans-serif; }
        .report-meta { text-align: right; font-family: sans-serif; }
        .report-title { font-size: 16px; font-weight: bold; text-transform: uppercase; margin-bottom: 5px; }
        .report-details { font-size: 12px; }

        
        .kpi-section { margin-bottom: 30px; }
        .section-heading { font-size: 14px; font-weight: bold; text-transform: uppercase; border-bottom: 1px solid #000; margin-bottom: 10px; padding-bottom: 5px; font-family: sans-serif;}
        .kpi-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-family: sans-serif; }
        .kpi-table th, .kpi-table td { border: 1px solid #000; padding: 10px; text-align: center; }
        .kpi-table th { background: #f0f0f0; font-size: 11px; text-transform: uppercase; }
        .kpi-table td.val { font-size: 16px; font-weight: bold; }
        
        
        .chart-meta-text {
            font-size: 12px; font-style: italic; margin-bottom: 8px; font-family: sans-serif;
        }

        
        .charts-row { display: flex; gap: 20px; margin-bottom: 30px; }
        .chart-box { flex: 1; border: 1px solid #000; padding: 15px; background: #fff; }
        .chart-box-full { border: 1px solid #000; padding: 15px; margin-bottom: 30px; background: #fff; }
        .chart-title { font-size: 13px; font-weight: bold; text-align: center; margin-bottom: 5px; font-family: sans-serif; text-transform: uppercase; }
        .chart-wrap { position: relative; height: 220px; width: 100%; }

        
        .data-table { width: 100%; border-collapse: collapse; font-family: sans-serif; margin-bottom: 20px; }
        .data-table th, .data-table td { border: 1px solid #000; padding: 6px 8px; font-size: 12px; text-align: left; }
        .data-table th { background: #f0f0f0; font-weight: bold; text-transform: uppercase; }
        .data-table th.right, .data-table td.right { text-align: right; }
        .data-table th.center, .data-table td.center { text-align: center; }
        .data-table tbody tr:nth-child(even) { background: #fafafa; }

        
        .report-footer {
            margin-top: 40px; padding-top: 15px; border-top: 1px solid #000;
            display: flex; justify-content: space-between; font-family: sans-serif; font-size: 11px;
        }
    </style>
</head>
<body>

    <div class="report-header">
        <div class="logo-block">
            <div class="logo-icon">TM</div>
            <div>
                <div class="logo-text">TechnoMarkt</div>
                <div class="logo-sub">Фінансово-аналітичний відділ</div>
            </div>
        </div>
        <div class="report-meta">
            <div class="report-title">ФІНАНСОВИЙ ЗВІТ #@DateTime.Now.ToString("MMdd-HHmm")</div>
            <div class="report-details">
                <strong>Період:</strong> @periodLabel <br />
                <strong>Сформовано:</strong> @generatedAt
            </div>
        </div>
    </div>

    <div class="kpi-section">
        <div class="section-heading">1. ЗВЕДЕНІ ПОКАЗНИКИ</div>
        <table class="kpi-table">
            <thead>
                <tr>
                    <th>Виручка за рік (з 01.01.@DateTime.Now.Year)</th>
                    <th>Виручка за обраний період</th>
                    <th>Завершені замовлення</th>
                    <th>Середній чек</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="val">₴@Model.Kpi.YearlyRevenue.ToString("N2")</td>
                    <td class="val">₴@Model.Kpi.PeriodRevenue.ToString("N2")</td>
                    <td class="val">@Model.Kpi.CompletedOrdersCount</td>
                    <td class="val">₴@Model.Kpi.AverageOrder.ToString("N2")</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="section-heading">2. ГРАФІЧНА АНАЛІТИКА</div>
    
    <div class="charts-row">
        <div class="chart-box">
            <div class="chart-title">Динаміка продажів</div>
            <div class="chart-meta-text">Показано дані за тиждень від @Model.WeekStart.ToString("dd.MM.yyyy")</div>
            <div class="chart-wrap"><canvas id="dailySalesChart"></canvas></div>
        </div>
        <div class="chart-box">
            <div class="chart-title">Методи оплати</div>
            <div class="chart-meta-text">Розподіл за період @periodLabel</div>
            <div class="chart-wrap"><canvas id="paymentMethodsChart"></canvas></div>
        </div>
    </div>

    <div class="chart-box-full">
        <div class="chart-title">Квартальна виручка</div>
        <div class="chart-meta-text">Показано дані за @Model.QuarterlyYear рік</div>
        <div class="chart-wrap"><canvas id="quarterlyChart"></canvas></div>
    </div>

    <div class="section-heading">3. ДЕТАЛІЗАЦІЯ ОСТАННІХ ТРАНЗАКЦІЙ</div>
    <div class="chart-meta-text">Відображено останні транзакції магазину. Загальна кількість записів у базі: @Model.TransactionsTable.Rows.Count.</div>
    <table class="data-table">
        <thead>
            <tr>
                <th>ID Транзакції</th>
                <th>ID Замовлення</th>
                <th class="center">Дата</th>
                <th class="center">Час</th>
                <th class="center">Метод</th>
                <th class="center">Статус</th>
                <th class="right">Сума (UAH)</th>
            </tr>
        </thead>
        <tbody>
            @if(!Model.TransactionsTable.Rows.Any())
            {
                <tr><td colspan="7" class="center">Немає даних за обраний період</td></tr>
            }
            @foreach(var tx in Model.TransactionsTable.Rows.Take(25))
            {
                string statusLabel = tx.Status switch {
                    PaymentStatus.Completed => "Завершено",
                    PaymentStatus.Pending => "Очікується",
                    PaymentStatus.Failed => "Помилка",
                    PaymentStatus.Refunded => "Повернуто",
                    _ => "Невідомо"
                };
                <tr>
                    <td>@tx.PaymentId</td>
                    <td>@tx.OrderId</td>
                    <td class="center">@tx.PaidAt.ToString("dd.MM.yyyy")</td>
                    <td class="center">@tx.PaidAt.ToString("HH:mm")</td>
                    <td class="center">@(tx.Method == PayMethod.Cash ? "Готівка" : "Карта")</td>
                    <td class="center">@statusLabel</td>
                    <td class="right">@tx.Amount.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="report-footer">
        <div>Відповідальна особа: ______________ / __________________/</div>
        <div>Згенеровано в системі TechnoMarkt ERP</div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        Chart.defaults.color = '#000';
        Chart.defaults.font.family = 'sans-serif';

        const dailySalesRaw = @Html.Raw(JsonSerializer.Serialize(Model.DailySales.OrderBy(x => x.Key).Select(x => new { key = x.Key.ToString("dd.MM"), value = x.Value })));
        const methodsRaw = @Html.Raw(JsonSerializer.Serialize(Model.TransactionByMethod.Select(x => new { method = x.Key.ToString(), count = x.Value })));
        const quarterlyRaw = @Html.Raw(JsonSerializer.Serialize(Model.QuarterlyRevenue));

        window.addEventListener('load', () => {
            
            new Chart(document.getElementById('dailySalesChart'), {
                type: 'bar',
                data: {
                    labels: dailySalesRaw.map(x => x.key),
                    datasets: [{ data: dailySalesRaw.map(x => x.value), backgroundColor: '#555', borderColor: '#000', borderWidth: 1 }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
            });

            
            new Chart(document.getElementById('paymentMethodsChart'), {
                type: 'pie',
                data: {
                    labels: methodsRaw.map(x => x.method === 'Cash' ? 'Готівка' : x.method === 'Card' ? 'Карта' : x.method),
                    datasets: [{ data: methodsRaw.map(x => x.count), backgroundColor: ['#333', '#888', '#ccc'], borderColor: '#000', borderWidth: 1 }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });

            
            new Chart(document.getElementById('quarterlyChart'), {
                type: 'bar',
                data: {
                    labels: quarterlyRaw.map(q => `Квартал ${q.quarter}`),
                    datasets: [{ data: quarterlyRaw.map(q => q.revenue), backgroundColor: '#777', borderColor: '#000', borderWidth: 1 }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
            });
        });
    </script>
</body>
</html>
