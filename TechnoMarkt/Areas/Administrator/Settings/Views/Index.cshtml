@model SettingsViewModel
@{
    ViewData["Title"] = "Налаштування";
}

<div class="space-y-6">
    <div class="flex items-center gap-3 mb-6">
        <i class="fa-solid fa-gear text-3xl text-gray-700"></i>
        <h1 class="text-3xl font-bold text-gray-900">@ViewData["Title"]</h1>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg flex items-center gap-2">
            <i class="fa-solid fa-circle-check"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex items-center gap-2">
            <i class="fa-solid fa-circle-xmark"></i>
            @TempData["Error"]
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
            <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
                <i class="fa-solid fa-database text-blue-600"></i> Резервне копіювання
            </h2>
            <p class="text-sm text-gray-500 mb-4">Створення та відновлення резервної копії бази даних</p>

            <div class="space-y-3">
                <a asp-action="CreateBackup" class="block w-full bg-blue-600 hover:bg-blue-700 text-white text-center font-semibold py-2.5 px-4 rounded-lg transition-colors">
                    <i class="fa-solid fa-download mr-2"></i>Створити бекап
                </a>

                <form asp-action="RestoreBackup" method="post" enctype="multipart/form-data" class="space-y-3">
                    @Html.AntiForgeryToken()
                    <label class="block">
                        <span class="text-sm font-medium text-gray-700">Файл відновлення (.sql):</span>
                        <input type="file" name="backupFile" accept=".sql" class="mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
                    </label>
                    <button type="submit" class="block w-full border-2 border-orange-500 text-orange-600 hover:bg-orange-50 font-semibold py-2.5 px-4 rounded-lg transition-colors" onclick="return confirm('УВАГА: Ця дія перезапише поточні дані бази даних. Продовжити?')">
                        <i class="fa-solid fa-upload mr-2"></i>Відновити з бекапу
                    </button>
                </form>
            </div>
        </div>

        <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
            <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
                <i class="fa-solid fa-sliders text-gray-700"></i> Системні налаштування
            </h2>

            <form asp-action="UpdateSettings" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Шлях збереження бекапів</label>
                    <input type="text" name="@(nameof(Model.AppSettings))[BackupPath]" value="@(Model.AppSettings.TryGetValue("BackupPath", out var bp) ? bp : "")" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="C:\Backups" />
                </div>
                <button type="submit" class="w-full bg-gray-800 hover:bg-gray-900 text-white font-semibold py-2 px-4 rounded-lg transition-colors">
                    <i class="fa-solid fa-save mr-2"></i>Зберегти
                </button>
            </form>
        </div>
    </div>

    <div id="eventlogs-table-container">
        @await Html.PartialAsync("~/Areas/Administrator/_Shared/Views/Shared/Tables/_EventLogsTable.cshtml", Model.EventLogsTable)
    </div>
</div>

<script>
        let eventLogsFetchTimeout = null;

        document.addEventListener('input', (e) => {
            if (e.target.closest('#eventlogs-filter')) {
                clearTimeout(eventLogsFetchTimeout);
                eventLogsFetchTimeout = setTimeout(() => filterEventLogs(), 400);
            }
        });

        document.addEventListener('change', (e) => {
            if (e.target.closest('#eventlogs-filter')) {
                clearTimeout(eventLogsFetchTimeout);
                eventLogsFetchTimeout = setTimeout(() => filterEventLogs(), 400);
            }
        });

        async function filterEventLogs() {
            const form = document.getElementById('eventlogs-filter');
            try {
                const result = await fetch('@Url.Action("FilterEventLogs", "Settings", new { area = "Administrator" })', {
                    method: 'POST',
                    body: new URLSearchParams(new FormData(form))
                });
                const html = await result.text();
                document.getElementById('eventlogs-table-container').innerHTML = html;
            } catch (err) {
                console.error('EventLogs filter error:', err);
            }
        }

        function resetEventLogsFilter() {
            const form = document.getElementById('eventlogs-filter');
            form.reset();
            filterEventLogs();
        }
    </script>
}


