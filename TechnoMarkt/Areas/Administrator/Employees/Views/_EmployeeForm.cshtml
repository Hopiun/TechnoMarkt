@model EmployeeFormVM

@{
    bool isEdit = Model?.Action == FormAction.Edit;
    string title = isEdit ? "Редагування працівника" : "Додавання працівника";
    string submitUrl = isEdit ? $"/Administrator/Employees/EditEmployee" : "/Administrator/Employees/AddEmployee";
}

<div id="employee-modal-overlay" class="fixed inset-0 z-50 overflow-y-auto bg-gray-900/50 backdrop-blur-sm flex items-start justify-center pt-10 pb-10 opacity-0 pointer-events-none transition-opacity" onclick="if(event.target===this) closeEmployeeModal()">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-xl mx-4 overflow-hidden transform transition-all">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
            <div>
                <h3 class="text-lg font-bold text-gray-900 tracking-tight">@title</h3>
                @if (isEdit)
                {
                    <p class="text-xs text-gray-400 mt-0.5">ID працівника: @Model?.Id</p>
                }
            </div>
            <button type="button" onclick="closeEmployeeModal()" class="w-8 h-8 flex items-center justify-center rounded-lg bg-white border border-gray-200 text-gray-400 hover:text-gray-600 hover:bg-gray-50 transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form action="@submitUrl" method="post" class="p-6" onsubmit="submitEmployeeForm(event)">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Action" />
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="StoreId" />

            <div asp-validation-summary="ModelOnly" class="text-xs text-red-500 mb-4 bg-red-50 p-2 rounded-lg"></div>

            <div class="space-y-4">
                @if (!isEdit)
                {
                    <div>
                        <label asp-for="Email" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Email (логін) <span class="text-red-400">*</span></label>
                        <input asp-for="Email" type="email" autocomplete="off" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" placeholder="employee@technomarkt.com" />
                        <span asp-validation-for="Email" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="Password" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Пароль <span class="text-red-400">*</span></label>
                            <input asp-for="Password" type="password" autocomplete="new-password" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" placeholder="Мін. 8 символів" />
                            <span asp-validation-for="Password" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="ConfirmPassword" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Підтвердження <span class="text-red-400">*</span></label>
                            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
                            <span asp-validation-for="ConfirmPassword" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                        </div>
                    </div>
                }

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="FirstName" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Ім'я <span class="text-red-400">*</span></label>
                        <input asp-for="FirstName" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" placeholder="Іван" />
                        <span asp-validation-for="FirstName" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="LastName" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Прізвище <span class="text-red-400">*</span></label>
                        <input asp-for="LastName" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" placeholder="Іваненко" />
                        <span asp-validation-for="LastName" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="Role" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Роль <span class="text-red-400">*</span></label>
                        <select asp-for="Role" asp-items="Html.GetEnumSelectList<EmployeeRole>()" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                        </select>
                        <span asp-validation-for="Role" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Status" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Статус</label>
                        @if (isEdit)
                        {
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<EmployeeStatus>()" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                            </select>
                        }
                        else
                        {
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<EmployeeStatus>()" disabled class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 opacity-60 cursor-not-allowed transition-all">
                            </select>
                            <input type="hidden" asp-for="Status" />
                        }
                        <span asp-validation-for="Status" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Salary" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Зарплата (₴)</label>
                        <input asp-for="Salary" type="number" step="0.01" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" placeholder="15000" />
                        <span asp-validation-for="Salary" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-3 mt-6 pt-4 border-t border-gray-100">
                <button type="button" onclick="closeEmployeeModal()" class="px-5 py-2.5 text-sm font-medium text-gray-600 hover:text-gray-800 transition-colors">
                    Скасувати
                </button>
                <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold py-2.5 px-4 rounded-xl transition-colors shadow-sm">
                    <i class="fa-solid fa-check mr-2"></i>@(isEdit ? "Зберегти зміни" : "Створити працівника")
                </button>
            </div>
        </form>
    </div>
</div>


