@model StoreFormVM

@{
    string title = "Редагування магазину";
    string submitUrl = "/Administrator/Employees/EditStore";
}

<div id="store-modal-overlay" class="fixed inset-0 z-50 overflow-y-auto bg-gray-900/50 backdrop-blur-sm flex items-start justify-center pt-10 pb-10 opacity-0 pointer-events-none transition-opacity" onclick="if(event.target===this) closeStoreModal()">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-xl mx-4 overflow-hidden transform transition-all">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
            <div>
                <h3 class="text-lg font-bold text-gray-900 tracking-tight">@title</h3>
                @if (Model?.StoreId.HasValue == true)
                {
                    <p class="text-xs text-gray-400 mt-0.5">ID магазину: @Model.StoreId</p>
                }
            </div>
            <button type="button" onclick="closeStoreModal()" class="w-8 h-8 flex items-center justify-center rounded-lg bg-white border border-gray-200 text-gray-400 hover:text-gray-600 hover:bg-gray-50 transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form action="@submitUrl" method="post" class="p-6" onsubmit="submitStoreForm(event)">
            <input type="hidden" asp-for="StoreId" />
            <input type="hidden" asp-for="Action" />

            <div asp-validation-summary="ModelOnly" class="text-xs text-red-500 mb-4 bg-red-50 p-2 rounded-lg"></div>

            <div class="space-y-4">
                <div>
                    <label asp-for="CityId" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Місто <span class="text-red-400">*</span></label>
                    <select asp-for="CityId" asp-items="Model?.Cities" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                        <option value="">-- Оберіть місто --</option>
                    </select>
                    <span asp-validation-for="CityId" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Address" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Адреса <span class="text-red-400">*</span></label>
                    <input asp-for="Address" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" placeholder="вул. Хрещатик, 1" />
                    <span asp-validation-for="Address" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Phone" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Телефон</label>
                        <input asp-for="Phone" type="tel" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" placeholder="+380XXXXXXXXX" />
                        <span asp-validation-for="Phone" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="AdminId" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Адміністратор</label>
                        <select asp-for="AdminId" asp-items="Model?.Administrators" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                            <option value="">-- Без адміністратора --</option>
                        </select>
                        <span asp-validation-for="AdminId" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-3 mt-6 pt-4 border-t border-gray-100">
                <button type="button" onclick="closeStoreModal()" class="px-5 py-2.5 text-sm font-medium text-gray-600 hover:text-gray-800 transition-colors">
                    Скасувати
                </button>
                <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold py-2.5 px-4 rounded-xl transition-colors shadow-sm">
                    <i class="fa-solid fa-check mr-2"></i>Зберегти зміни
                </button>
            </div>
        </form>
    </div>
</div>


