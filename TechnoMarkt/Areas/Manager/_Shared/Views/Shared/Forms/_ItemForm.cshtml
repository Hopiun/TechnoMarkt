@model ItemFormVM

@{
    bool isEdit = Model?.Action == FormAction.Edit;
    string title = isEdit ? "Редагування товару" : "Додавання товару";
    string submitUrl = isEdit ? $"/Manager/Catalog/EditItem?itemId={Model.Id}" : "/Manager/Catalog/AddItem";
}

<div class="fixed inset-0 z-50 overflow-y-auto bg-gray-900/50 backdrop-blur-sm flex items-start justify-center pt-10 pb-10 custom-form-overlay" onclick="if(event.target===this) closeFormModal()">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-2xl mx-4 overflow-hidden transform transition-all">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
            <div>
                <h3 class="text-lg font-bold text-gray-900 tracking-tight">@title</h3>
            </div>
            <button type="button" onclick="closeFormModal()" class="w-8 h-8 flex items-center justify-center rounded-lg bg-white border border-gray-200 text-gray-400 hover:text-gray-600 hover:bg-gray-50 transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form action="@submitUrl" method="post" enctype="multipart/form-data" class="p-6" onsubmit="submitItemForm(event)">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" value="@Model?.Id" />
            <input type="hidden" asp-for="Action" value="@Model?.Action" />
            
            <div asp-validation-summary="ModelOnly" class="text-xs text-red-500 mb-4 bg-red-50 p-2 rounded-lg"></div>

            <div class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="col-span-1 sm:col-span-2">
                        <label asp-for="Name" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Назва <span class="text-red-400">*</span></label>
                        <input asp-for="Name" value="@Model?.Name" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white transition-all" placeholder="Сматрфон Apple iPhone 15..." />
                        <span asp-validation-for="Name" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="CategoryId" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Категорія <span class="text-red-400">*</span></label>
                        <select asp-for="CategoryId" asp-items="@Model?.Categories" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white transition-all">
                            <option value="">-- Оберіть категорію --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="BrandId" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Бренд <span class="text-red-400">*</span></label>
                        <select asp-for="BrandId" asp-items="@Model?.Brands" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white transition-all">
                            <option value="">-- Оберіть бренд --</option>
                        </select>
                        <span asp-validation-for="BrandId" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Price" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Ціна (₴) <span class="text-red-400">*</span></label>
                        <input type="number" step="0.01" asp-for="Price" value="@Model?.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white transition-all" placeholder="999.00" />
                        <span asp-validation-for="Price" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                    </div>
                    
                    <div>
                        <label asp-for="SupplierId" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Постачальник <span class="text-red-400">*</span></label>
                        <select asp-for="SupplierId" asp-items="@Model?.Suppliers" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white transition-all">
                            <option value="">-- Оберіть постачальника --</option>
                        </select>
                        <span asp-validation-for="SupplierId" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Weight" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Вага (кг)</label>
                        <input type="number" step="0.01" asp-for="Weight" value="@Model?.Weight?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white transition-all" placeholder="1.5" />
                        <span asp-validation-for="Weight" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Dimensions" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Габарити (ВхШхГ)</label>
                        <input asp-for="Dimensions" value="@Model?.Dimensions" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white transition-all" placeholder="10x20x5" />
                        <span asp-validation-for="Dimensions" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                    </div>

                    <div class="col-span-1 sm:col-span-2">
                        <label asp-for="Description" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Опис</label>
                        <textarea asp-for="Description" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white transition-all resize-none min-h-[80px]" placeholder="Короткий опис товару...">@Model?.Description</textarea>
                        <span asp-validation-for="Description" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                    </div>

                    
                    <div class="col-span-1 sm:col-span-2">
                        <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Зображення</label>
                        
                        <div class="relative w-max">
                            <input type="file" name="Image" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" onchange="document.getElementById('file-name').textContent = this.files.length ? this.files[0].name : 'Файл не обрано'" />
                            <div class="flex items-center gap-3">
                                <span class="px-4 py-2 rounded-full border border-gray-100 text-[13px] font-bold bg-blue-50 text-blue-600 shadow-sm pointer-events-none">Обрати файл</span>
                                <span id="file-name" class="text-[13px] text-gray-500 font-medium">Файл не обрано</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model?.CurrentImageUrl))
                        {
                            <div class="mt-2 text-[11px] text-gray-500 font-medium">Поточне: <a href="@Model.CurrentImageUrl" target="_blank" class="text-blue-500 hover:text-blue-600 underline transition-colors">Переглянути картинку</a></div>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-8 flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
                <button type="button" onclick="closeFormModal()" class="px-4 py-2 rounded-lg text-sm font-semibold tracking-wide text-gray-500 bg-gray-100 hover:bg-gray-200 transition-colors">
                    Скасувати
                </button>
                <button type="submit" class="px-5 py-2 rounded-lg text-sm font-bold tracking-wide text-white bg-blue-600 hover:bg-blue-700 shadow-md transition-all flex items-center gap-2">
                    <i class="fa-solid @(isEdit ? "fa-floppy-disk" : "fa-plus") text-xs"></i>
                    @(isEdit ? "Зберегти" : "Створити")
                </button>
            </div>
        </form>
    </div>
</div>


