@model SupplierFormVM

@{
    var formModel = Model as SupplierFormVM;
    bool isEdit = formModel?.Action == FormAction.Edit;
    string title = isEdit ? "Редагування постачальника" : "Додавання постачальника";
    string submitUrl = isEdit ? $"/Manager/Suppliers/EditSupplier?supplierId={formModel.Id}" : "/Manager/Suppliers/AddSupplier";
}

<div class="fixed inset-0 z-50 overflow-y-auto bg-gray-900/50 backdrop-blur-sm flex items-center justify-center supplier-form-overlay">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4 overflow-hidden transform transition-all">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
            <div>
                <h3 class="text-lg font-bold text-gray-900 tracking-tight">@title</h3>
                <p class="text-[11px] text-gray-400 mt-0.5">
                    @(isEdit ? $"Зміна даних існуючого постачальника #{formModel.Id}" : "Створення нового партнера")
                </p>
            </div>
            <button type="button" class="close-modal-btn w-8 h-8 flex items-center justify-center rounded-lg bg-white border border-gray-200 text-gray-400 hover:text-gray-600 hover:bg-gray-50 transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form id="supplier-form" action="@submitUrl" method="post" class="p-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" value="@formModel?.Id" />
            <input type="hidden" asp-for="Action" value="@formModel?.Action" />
            
            <div asp-validation-summary="ModelOnly" class="text-xs text-red-500 mb-4 bg-red-50 p-2 rounded-lg"></div>

            <div class="space-y-4">
                <div>
                    <label asp-for="Name" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Назва організації <span class="text-red-400">*</span></label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"><i class="fa-solid fa-building"></i></span>
                        <input asp-for="Name" value="@formModel?.Name" class="w-full pl-9 pr-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" placeholder="ТОВ 'ТехноПостач'" />
                    </div>
                    <span asp-validation-for="Name" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="CountryId" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Країна <span class="text-red-400">*</span></label>
                    <select asp-for="CountryId" asp-items="@formModel?.Countries" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                        <option value="">-- Оберіть країну --</option>
                    </select>
                    <span asp-validation-for="CountryId" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Contact" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Контактні дані</label>
                    <div class="relative">
                        <span class="absolute left-3 top-2.5 text-gray-400 text-sm"><i class="fa-solid fa-address-book"></i></span>
                        <textarea asp-for="Contact" class="w-full pl-9 pr-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all resize-none min-h-[80px]" placeholder="Email, телефон, контактна особа...">@formModel?.Contact</textarea>
                    </div>
                    <span asp-validation-for="Contact" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Rating" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Рейтинг (0-5)</label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-amber-400 text-sm"><i class="fa-solid fa-star"></i></span>
                        <input type="number" step="0.1" asp-for="Rating" value="@formModel?.Rating?.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" class="w-full pl-9 pr-3 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-gray-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" placeholder="4.5" />
                    </div>
                    <span asp-validation-for="Rating" class="text-[10px] text-red-500 font-medium mt-1 block"></span>
                </div>
            </div>

            <div class="mt-8 flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
                <button type="button" class="close-modal-btn px-4 py-2 rounded-lg text-sm font-semibold tracking-wide text-gray-500 bg-gray-100 hover:bg-gray-200 hover:text-gray-700 transition-colors">
                    Скасувати
                </button>
                <button type="submit" class="px-5 py-2 rounded-lg text-sm font-bold tracking-wide text-white bg-blue-600 hover:bg-blue-700 shadow-md hover:shadow-lg transition-all flex items-center gap-2">
                    <i class="fa-solid @(isEdit ? "fa-floppy-disk" : "fa-plus") text-xs"></i>
                    @(isEdit ? "Зберегти" : "Створити")
                </button>
            </div>
        </form>
    </div>
</div>

