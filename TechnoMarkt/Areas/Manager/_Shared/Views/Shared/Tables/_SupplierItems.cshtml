@model Dictionary<string, List<SupplierItemsRow>>

<td colspan="10" class="p-0 border-b border-gray-100 bg-blue-50/20">
    <div class="px-8 py-5">
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden p-5">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-50">
                <h4 class="text-sm font-bold text-gray-900 tracking-tight flex items-center gap-2">
                    <span class="w-6 h-6 rounded-md bg-blue-100 text-blue-600 flex items-center justify-center">
                        <i class="fa-solid fa-boxes-stacked text-xs"></i>
                    </span>
                    Каталог товарів постачальника
                </h4>
                <button class="close-details-btn text-[10px] font-bold uppercase tracking-wider text-gray-400 hover:text-gray-600 px-3 py-1.5 rounded bg-gray-50 hover:bg-gray-100 transition-colors flex items-center gap-1.5">
                    <i class="fa-solid fa-xmark"></i> Закрити
                </button>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-6 text-gray-400 flex flex-col items-center gap-2">
                    <i class="fa-solid fa-box-open text-2xl opacity-40"></i>
                    <p class="text-sm font-medium">Товари не знайдені</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    @foreach (var categoryGroup in Model)
                    {
                        <div class="bg-gray-50/50 rounded-lg p-4 border border-gray-100">
                            <h5 class="text-xs font-bold text-gray-600 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                                <i class="fa-solid fa-layer-group text-blue-400"></i> @categoryGroup.Key
                            </h5>
                            <div class="space-y-2.5">
                                @foreach (var item in categoryGroup.Value)
                                {
                                    <div class="bg-white p-3 rounded-lg shadow-sm border border-gray-50/50 hover:shadow-md transition-shadow">
                                        <div class="flex justify-between items-start mb-1">
                                            <p class="text-sm font-semibold text-gray-900 leading-tight">@item.ItemName</p>
                                            <p class="text-[11px] font-bold text-green-600 bg-green-50 px-1.5 py-0.5 rounded ml-2 whitespace-nowrap">₴@item.Price.ToString("N0")</p>
                                        </div>
                                        <div class="flex items-center gap-3 text-[10px] text-gray-400 font-medium">
                                            <span title="Бренд" class="flex items-center gap-1">
                                                <i class="fa-solid fa-tag opacity-70"></i> @item.Brand
                                            </span>
                                            @if (item.Weight.HasValue && item.Weight > 0)
                                            {
                                                <span title="Вага" class="flex items-center gap-1">
                                                    <i class="fa-solid fa-weight-hanging opacity-70"></i> @item.Weight кг
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</td>
