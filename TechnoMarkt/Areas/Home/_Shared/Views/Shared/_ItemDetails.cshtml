@model ItemVM

<div class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4" onclick="closeDetailsModal()">
    <div class="bg-white rounded-2xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">
        <div class="sticky top-0 bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between rounded-t-2xl z-10">
            <h2 class="text-lg font-bold text-gray-900">@Model.Name</h2>
            <button onclick="closeDetailsModal()" class="w-9 h-9 flex items-center justify-center rounded-lg hover:bg-gray-100 transition-colors text-gray-500">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-gray-100 rounded-2xl aspect-square flex items-center justify-center overflow-hidden">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="w-full h-full object-contain p-6" />
                }
                else
                {
                    <i class="fa-solid fa-camera text-gray-300 text-8xl"></i>
                }
            </div>

            <div class="space-y-5">
                <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">@Model.BrandName</p>
                    <h3 class="text-2xl font-extrabold text-gray-900 leading-tight">@Model.Name</h3>
                    <p class="text-sm text-gray-500 mt-1">Категорія: <span class="font-medium text-gray-700">@Model.CategoryName</span></p>
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div>
                        <h4 class="text-sm font-bold text-gray-900 mb-2 flex items-center gap-2">
                            <i class="fa-solid fa-align-left text-[#003DA5]"></i> Опис
                        </h4>
                        <p class="text-sm text-gray-600 leading-relaxed">@Model.Description</p>
                    </div>
                }

                <div class="grid grid-cols-2 gap-4">
                    @if (Model.Weight.HasValue)
                    {
                        <div class="bg-gray-50 rounded-xl p-3 border border-gray-200">
                            <p class="text-xs text-gray-500 mb-0.5"><i class="fa-solid fa-weight-scale text-gray-400 mr-1"></i>Вага</p>
                            <p class="text-sm font-bold text-gray-900">@Model.Weight.Value кг</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Dimensions))
                    {
                        <div class="bg-gray-50 rounded-xl p-3 border border-gray-200">
                            <p class="text-xs text-gray-500 mb-0.5"><i class="fa-solid fa-ruler-combined text-gray-400 mr-1"></i>Габарити</p>
                            <p class="text-sm font-bold text-gray-900">@Model.Dimensions</p>
                        </div>
                    }
                </div>

                <div class="pt-4 border-t border-gray-200">
                    <div class="flex items-baseline gap-3 mb-3">
                        @if (Model.Discount != null)
                        {
                            <span class="text-lg font-medium text-gray-400 line-through">₴@Model.Price.ToString("N0")</span>
                        }
                        <span class="text-3xl font-extrabold text-[#003DA5]">₴@Model.FinalPrice.ToString("N0")</span>
                        @if (Model.Discount != null)
                        {
                            <span class="bg-red-500 text-white text-xs font-bold px-2 py-0.5 rounded">-@Model.Discount.Percent%</span>
                        }
                    </div>

                    <p class="text-sm font-semibold flex items-center gap-2 mb-4 @(Model.StockStatus == StockStatus.InStock ? "text-emerald-600" : Model.StockStatus == StockStatus.Low ? "text-amber-500" : "text-red-500")">
                        <i class="fa-solid @(Model.StockStatus != StockStatus.OutOfStock ? "fa-circle-check" : "fa-circle-xmark")"></i>
                        @(Model.StockStatus == StockStatus.InStock ? $"В наявності ({Model.StockQuantity} шт.)" : Model.StockStatus == StockStatus.Low ? $"Мало ({Model.StockQuantity} шт.)" : "Немає в наявності")
                    </p>

                    @if (Model.StockStatus != StockStatus.OutOfStock)
                    {
                        <div class="flex items-center gap-3">
                            <div class="flex items-center border border-gray-300 rounded-xl overflow-hidden">
                                <button type="button" onclick="changeQty(-1)" class="px-3 py-2.5 bg-gray-50 hover:bg-gray-100 text-gray-700 transition-colors">
                                    <i class="fa-solid fa-minus text-xs"></i>
                                </button>
                                <input type="number" id="qty-input" value="1" min="1" max="@Model.StockQuantity" class="w-16 px-2 py-2 text-center text-sm font-bold text-gray-900 border-x border-gray-300 focus:outline-none" />
                                <button type="button" onclick="changeQty(1)" class="px-3 py-2.5 bg-gray-50 hover:bg-gray-100 text-gray-700 transition-colors">
                                    <i class="fa-solid fa-plus text-xs"></i>
                                </button>
                            </div>

                            <button type="button" onclick="submitCartItem(@Model.Id)" class="flex-1 py-2.5 bg-[#FFE000] text-[#1A1A2E] font-bold text-sm rounded-xl hover:brightness-110 transition-all flex items-center justify-center gap-2">
                                <i class="fa-solid fa-cart-plus"></i> Додати в кошик
                            </button>
                        </div>
                    }
                    else
                    {
                        <button type="button" disabled class="w-full py-2.5 bg-gray-200 text-gray-500 font-semibold text-sm rounded-xl cursor-not-allowed">
                            <i class="fa-solid fa-ban mr-1"></i> Немає в наявності
                        </button>
                    }
                </div>

                <div class="pt-4 border-t border-gray-200">
                    <p class="text-xs text-gray-500"><i class="fa-solid fa-truck text-gray-400 mr-1"></i> Швидка доставка по всій Україні</p>
                    <p class="text-xs text-gray-500 mt-1"><i class="fa-solid fa-shield-halved text-gray-400 mr-1"></i> Офіційна гарантія виробника</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function changeQty(delta) {
        const input = document.getElementById('qty-input');
        let val = parseInt(input.value) + delta;
        val = Math.max(1, Math.min(val, @Model.StockQuantity));
        input.value = val;
    }
</script>

